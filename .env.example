# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/nutrilens

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_at_least_256_bits_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_at_least_256_bits_long
JWT_REFRESH_EXPIRY=7d

# Gemini API (For nutrition estimation & coaching)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Integration (For meal image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
